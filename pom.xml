<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		spring-boot-starter-parent：SpringBoot 官方"父 POM"。
		它做了三件重要的事：
		  1. 统一管理所有 SpringBoot 相关依赖的版本（不用我们一个个写 version）
		  2. 配置好 Maven 编译插件（Java 版本、编码等）
		  3. 提供默认的插件配置（spring-boot-maven-plugin）
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!-- 本项目坐标：groupId.artifactId:version 唯一标识一个构件 -->
	<groupId>com.hiya</groupId>
	<artifactId>hiya-server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>hiya-server</name>
	<description>Hiya 聊天软件服务端（SpringBoot 重构版，B-S 架构）</description>

	<properties>
		<!-- 编译用的 Java 版本 -->
		<java.version>17</java.version>
	</properties>

	<dependencies>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			REST API 基础：Spring MVC + 内嵌 Tomcat + Jackson(JSON 序列化)。
			(Spring Boot 4 把原来的 spring-boot-starter-web 拆成了 webmvc / webflux 两个 starter)
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!--
			WebSocket：实时通信（替代旧版 Hiya 的 Socket 长连接）。
			浏览器原生支持 WebSocket，这是 B-S 架构下聊天推送的标准方案。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

		<!--
			参数校验：@Valid + @NotBlank / @Size 等注解（由 hibernate-validator 实现）。
			让"参数合法性检查"声明式地写在 DTO 字段上，Controller 不用手写 if 判断。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
			JPA：对象关系映射（ORM），替代旧版手写 JDBC。
			写一个接口继承 JpaRepository 就能获得全套 CRUD，SQL 由框架生成。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- MySQL 驱动（JDBC 底层连接 MySQL 用） -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			【已按需求移除】JWT 相关依赖（原 jjwt-api / jjwt-impl / jjwt-gson / gson）
			本项目已简化：取消认证环节，改为
			  - REST 请求头携带 X-User-Id
			  - WebSocket 连接携带 ?userId=
			仅做"身份标识"不做"身份校验"（见 com.hiya.identity 包）。
			将来若要恢复认证，重新引入 io.jsonwebtoken 的 jjwt-* 依赖即可。
		-->

		<!-- 测试依赖：JUnit 5 + SpringBoot 测试支持 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				SpringBoot 打包插件：
				  1. mvn package 时把应用打成"可执行 jar"（内含 Tomcat，java -jar 即可运行）
				  2. 提供 mvn spring-boot:run 启动命令
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
